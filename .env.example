# ==============================================================================
# SCDM Configuration Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# API Credentials (REQUIRED FOR DEMO/LIVE)
# ------------------------------------------------------------------------------
# Provide your Google Gemini API key to enable LLM interpretation and extraction.
GEMINI_API_KEY="INSERT_YOUR_GEMINI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# Neo4j Database Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# The URI for connecting to the canonical Neo4j graph.
NEO4J_URI="bolt://127.0.0.1:7687"

# Authentication for Neo4j
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="INSERT_YOUR_NEO4J_PASSWORD_HERE"

# (Optional) Specific database to use, typically "neo4j"
# NEO4J_DATABASE="neo4j"

# ------------------------------------------------------------------------------
# Core Model Configuration
# ------------------------------------------------------------------------------
# The specific Gemini model to use for extraction/reasoning.
GEMINI_MODEL="gemini-3.8-flash"

# Maximum number of LLM calls allowed per workflow (prevents runaway costs).
LLM_BUDGET=10

# ------------------------------------------------------------------------------
# Graph Traversal Configuration
# ------------------------------------------------------------------------------
# Maximum depth for upstream exposure traversal in the graph.
# (WARNING: Values > 4 may cause massive exponential subgraph expansion)
MAX_TRAVERSAL_DEPTH=3

# ------------------------------------------------------------------------------
# Application Mode
# ------------------------------------------------------------------------------
# Defines the operational boundary:
# MOCK - Bypasses external LLM/Search and uses deterministic fixtures.
# DEMO - Requires live API keys but implements safe boundaries and budget limits.
# LIVE - Fully enabled for production deployments.
APP_MODE="MOCK"
